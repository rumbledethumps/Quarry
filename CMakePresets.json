{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "description": "llvm-mos, optimized for size, with debug information",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/llvm-mos/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-g -Oz",
                "LLVM_MOS_PLATFORM": "rp6502"
            }
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "description": "llvm-mos, optimized for size",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/llvm-mos/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS_RELEASE": "-Oz -DNDEBUG",
                "LLVM_MOS_PLATFORM": "rp6502"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "configurePreset": "llvm-mos/Debug",
            "targets": ["all"]
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "configurePreset": "llvm-mos/Release",
            "targets": ["all"]
        }
    ]
}
